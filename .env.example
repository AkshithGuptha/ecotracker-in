# Server Configuration
PORT=5000
FRONTEND_ORIGIN=https://ecotrackr-service.onrender.com

# Database Connection (MongoDB Atlas for Production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/ecotrack?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Third-Party API Keys & Services
CLIMATIQ_API_KEY=your_climatiq_api_key_here
CLIMATIQ_API_URL=https://api.climatiq.io/estimate
OPENAI_API_KEY=your_openai_api_key_here

# Auth0 Credentials (Create at https://manage.auth0.com)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id_here


# Email Credentials (Optional / Nodemailer)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password_here

# Frontend API Configuration (Leave blank in production for same-origin)
VITE_API_URL=
VITE_API_BASE=

# Firebase Config (Optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
